{
  "name": "raw-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Fully client-side, GitHub Pages-hosted OSS RAW developer web app.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
