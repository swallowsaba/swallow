{
  // ==================================================================
  //  首都圏ルート提案ツール — Cloudflare Worker 設定
  //  ------------------------------------------------------------------
  //  デプロイ:  npx wrangler deploy
  //  シークレット(Git には絶対に入れない):
  //      npx wrangler secret put ODPT_TOKEN
  // ==================================================================
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kanto-transit-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",

  // ------------------------------------------------------------------
  //  公開 URL(*.workers.dev)
  // ------------------------------------------------------------------
  //  これを書いておかないと、デプロイのたびに設定が揺れて
  //  「Error 1031 Invalid Workers Preview configuration」になることがある。
  //  workers_dev  : https://<worker名>.<サブドメイン>.workers.dev を有効にする
  //  preview_urls : <版>-<worker名>... のプレビュー URL。使わないので無効。
  //                 (wrangler v4.34 以降は既定で false)
  "workers_dev": true,
  "preview_urls": false,

  // Workers Cache。Worker が返す Cache-Control ヘッダに従ってキャッシュし、
  // 同時リクエストを 1 本に束ねる。workers.dev サブドメインでも動作する。
  "cache": {
    "enabled": true
  },

  "observability": {
    "enabled": true
  },

  // ------------------------------------------------------------------
  //  公開してよい設定値。シークレットはここに書かないこと。
  // ------------------------------------------------------------------
  "vars": {
    // CORS 許可オリジン(カンマ区切り・完全一致・末尾スラッシュなし)
    // GitHub Pages の URL は https://<ユーザー名>.github.io です。
    // パス(/<リポジトリ名>/)は Origin に含まれないので付けないこと。
    "ALLOWED_ORIGINS": "https://example.github.io,http://localhost:8080",

    // 対応事業者の絞り込み(空なら全件)
    // 例: "Toei,TokyoMetro"
    "ENABLED_OPERATORS": "",

    // 住所検索。"off" で無効化(現在地と駅名検索のみになる)
    "GEOCODER": "gsi",

    // ------------------------------------------------------------
    //  公共交通オープンデータチャレンジ2026
    // ------------------------------------------------------------
    //  "1" にすると JR東日本・東武・西武・京王・小田急・京急・東急・相鉄
    //  が有効になります。ただし別途 Secret が必要です:
    //      npx wrangler secret put ODPT_CHALLENGE_TOKEN
    //
    //  【重要】チャレンジ限定ライセンスは「コンテスト目的外の利用が禁止」
    //  されています。有効にしたアプリはチャレンジの応募作品としてのみ
    //  公開できます。コンテスト終了(2027-03-12)後はトークンが失効し、
    //  これらの事業者は自動的に無効化されます。
    //
    //  フラグとトークンの両方がそろわない限り有効になりません。
    "ENABLE_CHALLENGE": "0"
  }
}
