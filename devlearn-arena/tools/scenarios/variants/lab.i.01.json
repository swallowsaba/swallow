{
  "lesson": "lab.i.01",
  "variants": [
    {
      "name": "分けて打つ・状態を確かめる",
      "steps": {
        "web": [
          "sudo systemctl start nginx",
          "sudo systemctl enable nginx",
          "systemctl is-enabled nginx"
        ],
        "port": [
          "sudo ufw enable",
          "sudo ufw allow 80",
          "sudo ufw allow 443",
          "sudo ufw status"
        ],
        "name": [
          "echo '127.0.0.1 shop.example' | sudo tee -a /etc/hosts",
          "curl -i http://shop.example/"
        ],
        "tls": [
          "cp /home/learner/inbox/shop.example.crt /etc/nginx/certs/shop.crt",
          "cp /home/learner/inbox/shop.example.key /etc/nginx/certs/shop.key",
          "chmod go-rwx /etc/nginx/certs/shop.key",
          "sed -i 's|listen 80;|listen 443 ssl;|; /server_name/a ssl_certificate /etc/nginx/certs/shop.crt;' /etc/nginx/conf.d/shop.conf",
          "sed -i '/ssl_certificate /a ssl_certificate_key /etc/nginx/certs/shop.key;' /etc/nginx/conf.d/shop.conf",
          "nginx -t && nginx -s reload"
        ],
        "reboot": [
          "sudo reboot",
          "curl -s -o /dev/null -w '%{http_code}' https://shop.example/"
        ]
      }
    },
    {
      "name": "hosts を書き直す・秘密鍵を先に絞る",
      "steps": {
        "web": [
          "sudo systemctl enable --now nginx"
        ],
        "port": [
          "sudo ufw allow 443/tcp",
          "sudo ufw allow 80/tcp",
          "sudo ufw enable"
        ],
        "name": [
          "printf '127.0.0.1 localhost shop.example\\n' | sudo tee /etc/hosts"
        ],
        "tls": [
          "cd /etc/nginx/certs",
          "cp /home/learner/inbox/shop.example.* .",
          "chmod 600 shop.example.key",
          "cd",
          "sed -i 's/listen 80;/listen 443 ssl;/' /etc/nginx/conf.d/shop.conf",
          "sed -i '/server_name/a ssl_certificate /etc/nginx/certs/shop.example.crt;' /etc/nginx/conf.d/shop.conf",
          "sed -i '/server_name/a ssl_certificate_key /etc/nginx/certs/shop.example.key;' /etc/nginx/conf.d/shop.conf",
          "systemctl restart nginx"
        ],
        "reboot": [
          "sudo reboot",
          "systemctl is-active nginx",
          "curl -sS -o /dev/null -w '%{http_code}' https://shop.example/"
        ]
      }
    }
  ],
  "wrong": {
    "step": "port",
    "why": "sudo を付けずに打つ",
    "input": [
      "ufw allow 443/tcp"
    ],
    "retry": [
      "sudo ufw allow 80/tcp",
      "sudo ufw allow 443/tcp",
      "sudo ufw enable"
    ]
  }
}
