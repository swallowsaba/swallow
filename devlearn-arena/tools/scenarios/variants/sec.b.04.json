{
  "lesson": "sec.b.04",
  "variants": [
    {
      "name": "名前の印を付けて作る・-i を省いて登録する",
      "steps": {
        "pair": [
          "ssh-keygen -t ed25519 -C learner@pc"
        ],
        "register": [
          "ssh-copy-id deploy@web01",
          "ssh deploy@web01"
        ],
        "verify": [
          "ssh deploy@web01 'cat ~/.ssh/authorized_keys'",
          "cat ~/.ssh/id_ed25519.pub",
          "id_ed25519.pub"
        ]
      }
    },
    {
      "name": "置き場所と空の合言葉を指定して作る・手で足す",
      "steps": {
        "pair": [
          "ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519 -N ''"
        ],
        "register": [
          "cat ~/.ssh/id_ed25519.pub | ssh deploy@web01 'mkdir -p ~/.ssh && cat >> ~/.ssh/authorized_keys'",
          "ssh -i ~/.ssh/id_ed25519 deploy@web01"
        ],
        "verify": [
          "ssh deploy@web01 cat /home/deploy/.ssh/authorized_keys",
          "ls ~/.ssh",
          "cat ~/.ssh/id_ed25519.pub",
          " id_ed25519.pub"
        ]
      }
    }
  ],
  "wrong": {
    "step": "register",
    "why": "公開鍵を登録する前に入る",
    "input": [
      "ssh deploy@web01"
    ]
  }
}
