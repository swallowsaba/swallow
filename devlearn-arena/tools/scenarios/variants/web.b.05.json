      "name": "grep で見出しを拾う・-D で頭を出す",
      "steps": {
        "moved": [
          "curl -sI http://shop.example/menu-2025 | grep -i location",
          "/menu"
        ],
        "keep": [
          "curl -s -D - -o /dev/null http://shop.example/menu",
          "３６００"
        ]
      }
    }
  ],
