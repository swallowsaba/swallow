        "list": [
          "curl -s https://shop.example:8443/items | jq length",
          "４"
        ],
        "query": [
          "curl -G -d id=3 https://shop.example:8443/items",
          " 灯台の模型 "
        ]
      }
    }
  ],
  "wrong": {
