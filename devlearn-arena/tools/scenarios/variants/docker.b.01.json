    {
      "name": "-v で見る・service.名前で動かす・ps で数える",
      "steps": {
        "client": [
          "docker version",
          "docker -v",
          " 27.3.1"
        ],
        "start": [
          "sudo systemctl start docker.service",
          "docker version"
        ],
        "info": [
          "docker info",
          "docker ps",
          "３"
        ]
      }
    }
