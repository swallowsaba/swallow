{
  "id": "mon.i.01",
  "domain": "mon",
  "level": "intermediate",
  "theme": "トレース",
  "title": "トレース",
  "goal": "1 つの処理が複数のサービスを通る様子を追える",
  "minutes": 20,
  "prerequisites": [
    "mon.b.02",
    "k8s.b.06"
  ],
  "related": [
    "web.a.01",
    "k8s.b.06"
  ],
  "next": [
    "mon.i.03"
  ],
  "terms": [
    "service",
    "trace",
    "log",
    "app",
    "db",
    "authentication",
    "query-plan"
  ],
  "explain": {
    "what": "{{term:trace}}は、1 つの依頼が複数の{{term:service}}を通る様子を、区間ごとの時間で記録した物。依頼の番号 で区間をつなぎ、1 枚の図に積み重ねる。",
    "why": "サービスが 5 つあると、{{term:log}}をそれぞれ見ても、どこで遅れたかが分からない。トレースなら、時間を使った所がひと目で見える。",
    "use": "分散したシステムの調査に使う。遅い依頼を 1 つ選び、一番長い区間を探して、そのサービスの処理を調べる。",
    "when": "予約の画面が遅い。入口・{{term:app}}・{{term:authentication}}・{{term:db}}・外部の決済のどれが原因か、誰も分からない。",
    "figures": [
      "mon-i01-trace"
    ]
  },
  "understand": [
    {
      "kind": "figure-pick",
      "figure": "mon-i01-trace",
      "prompt": "図の中で、遅さの原因として調べる区間を押す。",
      "answer": [
        "db"
      ],
      "see": "what"
    },
    {
      "kind": "relation",
      "prompt": "2 つの関係を選ぶ。",
      "a": "サービスどうしが依頼の番号 を引き継ぐ",
      "b": "区間が 1 本につながる",
      "answer": "cause",
      "why": "同じ番号の区間を集めて 1 枚にする。引き継がないと、別々の依頼に見える。",
      "see": "what"
    }
  ],
  "quiz": [
    {
      "id": "q1",
      "kind": "cause",
      "prompt": "5 つの区間のうち、DB の区間だけが長い。原因はどこ？",
      "choices": [
        {
          "id": "a",
          "text": "DB のサービス（の検索）",
          "correct": true
        },
        {
          "id": "b",
          "text": "入口のサービス",
          "correct": false,
          "whyNot": "入口は親の区間で、子の時間を含む。自分の仕事は短い。"
        },
        {
          "id": "c",
          "text": "全てのサービス",
          "correct": false,
          "whyNot": "ほかの区間は短い。全体を調べる必要は無い。"
        }
      ],
      "explanation": "一番長い、子を持たない区間から調べる。"
    },
    {
      "id": "q2",
      "kind": "situation",
      "prompt": "トレースで区間が途中で切れて、別の依頼に見える。何を直す？",
      "choices": [
        {
          "id": "a",
          "text": "依頼の番号 を次のサービスへ引き継ぐ",
          "correct": true
        },
        {
          "id": "b",
          "text": "ログの量を増やす",
          "correct": false,
          "whyNot": "ログを増やしても、区間はつながらない。"
        },
        {
          "id": "c",
          "text": "サービスの数を減らす",
          "correct": false,
          "whyNot": "調べるために構成を変えるのは本末転倒。"
        }
      ],
      "explanation": "番号を見出しで渡し続けることで、1 本につながる。"
    },
    {
      "id": "q3",
      "kind": "predict",
      "prompt": "在庫と価格の 2 つを同時に問い合わせた。図はどうなる？",
      "choices": [
        {
          "id": "a",
          "text": "2 つの区間が時間の上で重なる",
          "correct": true
        },
        {
          "id": "b",
          "text": "必ず順に並ぶ",
          "correct": false,
          "whyNot": "順に並ぶのは、順に呼んだ時。"
        },
        {
          "id": "c",
          "text": "片方が消える",
          "correct": false,
          "whyNot": "どちらも記録される。"
        }
      ],
      "explanation": "並行に動かすと区間が重なる。全体の時間は長い方で決まる。"
    }
  ],
  "practice": {
    "mode": "simulation",
    "purpose": "予約の画面が遅い。1 つの遅い依頼のトレースを読み、原因のサービスと処理を答える。",
    "environment": "sim-read",
    "setup": {
      "questions": [
        {
          "id": "svc",
          "prompt": "遅さの原因のサービスは？",
          "options": [
            "入口",
            "予約のアプリ",
            "認証",
            "予約のDB",
            "外部の決済"
          ]
        },
        {
          "id": "op",
          "prompt": "原因の処理は？",
          "options": [
            "ログイン",
            "空き枠の検索",
            "決済の確定",
            "画面の組み立て"
          ]
        }
      ],
      "panels": [
        {
          "kind": "table",
          "title": "依頼 req-7f3a のトレース（全体 2400 ms）",
          "columns": [
            "サービス",
            "処理",
            "開始",
            "長さ",
            "時間の帯"
          ],
          "rows": [
            [
              "入口",
              "GET /reserve",
              "0 ms",
              "2400 ms",
              "████████████████████████"
            ],
            [
              "予約のアプリ",
              "画面の組み立て",
              "40 ms",
              "2300 ms",
              "·███████████████████████"
            ],
            [
              "認証",
              "ログイン",
              "60 ms",
              "60 ms",
              "·█"
            ],
            [
              "予約のDB",
              "空き枠の検索",
              "130 ms",
              "2050 ms",
              "·█████████████████████"
            ],
            [
              "外部の決済",
              "決済の確定",
              "2190 ms",
              "120 ms",
              "······················█"
            ]
          ]
        },
        {
          "kind": "text",
          "title": "読み方",
          "body": "親の区間は、子の区間の時間を含む。入口とアプリは、子を呼んで待っている時間が長いだけ。"
        }
      ]
    },
    "steps": [
      {
        "id": "service",
        "purpose": "トレースの表を読み、遅さの原因のサービスを答える。親の区間（入口・予約のアプリ）は子の時間を含むことに注意する。",
        "check": {
          "kind": "sim",
          "expr": "answered svc=予約のDB"
        },
        "afterward": "子を持たない区間で一番長いのは、予約の DB の 2050 ms。全体の 2400 ms のほとんどを占めている。",
        "hints": [
          "全体 → 親 → 子の順に見る。",
          "子を持たない区間の中で、一番長い物を探す。",
          "「遅さの原因のサービスは？」は「予約のDB」を押す。"
        ],
        "actions": [
          {
            "op": "answer",
            "question": "svc",
            "value": "予約のDB"
          }
        ],
        "expectedErrors": [
          "mon-span-parent"
        ]
      },
      {
        "id": "operation",
        "purpose": "そのサービスの、どの処理が原因かを答える。",
        "check": {
          "kind": "sim",
          "expr": "answered op=空き枠の検索"
        },
        "afterward": "空き枠の検索が原因と分かった。次は、この問い合わせの{{term:query-plan}}を調べる。ほかの 4 つのサービスを調べずに済んだ。",
        "hints": [
          "同じ行の「処理」の列を読む。",
          "予約の DB の行の処理を見る。",
          "「原因の処理は？」は「空き枠の検索」を押す。"
        ],
        "actions": [
          {
            "op": "answer",
            "question": "op",
            "value": "空き枠の検索"
          }
        ],
        "expectedErrors": [
          "mon-span-parent"
        ]
      }
    ]
  },
  "result": {
    "success": "区間の長さから、原因のサービスと処理を特定できた。",
    "partial": "ヒントを使って特定できた。次は親と子の区間を自分で見分けてみよう。",
    "retry": "親の区間を原因と見ていないか、子を持たない区間を見直そう。"
  },
  "summary": {
    "points": [
      "依頼の旅を記録する",
      "長い区間を探す",
      "依頼の番号 を引き継ぐ"
    ],
    "next": [
      "mon.i.03"
    ],
    "terms": [
      "trace",
      "span",
      "request-id"
    ]
  }
}
