      ]
    },
    "steps": [
      {
        "id": "start",
        "purpose": "利用者に近い数値（応答時間）から、遅さが始まった時刻を答える。",
        "check": {
          "kind": "sim",
          "expr": "answered 始まり=12:00"
        },
        "afterward": "遅い 5% の境（95 パーセンタイル）は、12:00 に 0.7 秒から 3.8 秒に跳ねた。平均は 0.3 秒から 0.45 秒にしか上がっていないので、平均だけを見ていたら見落とす。",
        "hints": [
          "まず利用者に近い数値（応答時間）で、いつから変わったかを見る。平均だけでなく、遅い方の線も見る。",
          "遅い 5% の線が大きく跳ねたのは、11:30 の後か、12:00 の後か。頼みの数が増えた時刻と取り違えない。",
          "「利用者が遅いと感じ始めた時刻は？」は「12:00」を押す。"
        ],
        "expectedErrors": [
          "mon-start-misread",
          "sim-no-such",
          "sim-usage"
        ],
        "actions": [
          {
            "op": "answer",
            "question": "始まり",
            "value": "12:00"
          }
        ]
      },
      {
        "id": "cause",
        "purpose": "同じ頃に変わった資源の中から、遅さの原因を答える。",
        "check": {
          "kind": "sim",
          "expr": "answered 原因=メモリ"
        },
        "afterward": "メモリは 9:00 の 2.1 GB から増え続け、12:00 に上限の 4.8 GB に届いた。そこからアプリは空きを作る片付けに追われ、CPU が 80% に跳ねて遅くなった。CPU は結果で、原因はメモリ。使い終わったメモリを解放していない（メモリリーク）疑いがある。",
        "hints": [
          "12:00 に一緒に跳ねた物と、その前から変わり始めていた物を分ける。先に変わり始め、12:00 に限りに届いた物が原因の候補。",
          "CPU は 12:00 に跳ねたが、それまでは 25% 前後。メモリは朝から増え続け、12:00 に上限 4.8 {{term:gb}} に届いた。頼みの数は 11:30 に増えたが、その時はまだ遅くない。",
          "「遅さの原因の資源は？」は「メモリ」を押す。"
        ],
        "expectedErrors": [
          "mon-result-as-cause",
          "sim-no-such",
          "sim-usage"
        ],
        "actions": [
          {
            "op": "answer",
            "question": "原因",
            "value": "メモリ"
          }
        ]
      }
    ]
  },
  "result": {
    "success": "グラフの変化から、遅さの始まり（12:00）と、原因（メモリが上限に届いた）を見つけた。",
    "partial": "ヒントを使って見つけた。次は、なぜ CPU は原因でなく結果なのかを、自分の言葉で説明してみよう。",
    "retry": "まだ答えが合っていない。4 つのグラフを 12:00 の所で縦に見比べ、12:00 に跳ねた物と、その前から変わっていた物を分けよう。"
  },
  "summary": {
    "points": [
      "異常は数値の変化として現れる。いつから・何と一緒に変わったかを見る",
      "平均だけで判断しない。遅い方（95 パーセンタイル）も見る",
      "先に変わり始めた物が原因の候補。{{term:log}}と突き合わせて確かめる"
    ],
    "next": [
      "mon.b.04",
      "mon.i.02"
    ],
    "terms": [
      "metrics",
      "percentile",
      "memory-leak"
    ]
  }
}
