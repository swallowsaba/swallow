{
  "id": "mon.b.03",
  "domain": "mon",
  "level": "beginner",
  "theme": "メトリクス",
  "title": "メトリクス",
  "goal": "数値の推移から異常を見つけられる",
  "minutes": 15,
  "prerequisites": [
    "mon.b.01"
  ],
  "related": [
    "linux.a.02",
    "web.a.01"
  ],
  "next": [
    "mon.b.04",
    "mon.i.02"
  ],
  "terms": [
    "metrics",
    "cpu",
    "memory",
    "response-time",
    "percentile",
    "error-rate",
    "memory-leak",
    "server",
    "disk",
    "app",
    "gb",
    "log"
  ],
  "explain": {
    "what": "{{term:metrics}}は、時刻ごとに測った数値の並び。{{term:cpu}} の使用率・{{term:memory}}の使用量・{{term:response-time}}・頼みの数などを、グラフにして見る。",
    "why": "異常は、数値の変化として現れる。いつから変わったか、何と同時に変わったかを見れば、原因に近づける。平均だけでは、一部の利用者だけが極端に遅いことを見落とすので、遅い方の{{term:percentile}}も見る。",
    "use": "異常に気付くことと、容量の計画（いつ機械を足すか）。まず利用者に近い数値（応答時間・{{term:error-rate}}）で異常の始まりを見つけ、同じ頃に変わった資源を探す。先に変わり始めた物が、原因の候補。",
    "when": "市の予約サイトが「昼から遅い」と言われた。朝 9 時からの、4 つのグラフがある。",
    "figures": [
      "mon-b03-graphs"
    ]
  },
  "understand": [
    {
      "kind": "figure-pick",
      "figure": "mon-b03-graphs",
      "prompt": "利用者が遅いと感じ始めた区間を押す。",
      "answer": [
        "noon"
      ],
      "see": "use"
    },
    {
      "kind": "yesno",
      "prompt": "応答時間の平均が普段どおりなら、全ての利用者が快適に使えている。",
      "answer": false,
      "why": "平均は、速い大勢と遅い少しを混ぜてならす。100 人のうち 5 人が 4 秒待っていても、平均は少ししか上がらない。遅い方の 95 パーセンタイルも見る。",
      "see": "why"
    }
  ],
  "quiz": [
    {
      "id": "q1",
      "kind": "predict",
      "prompt": "応答時間の平均は 0.5 秒で、普段とほとんど同じ。なのに「遅い」という声が来る。何が起きている？",
      "choices": [
        {
          "id": "a",
          "text": "一部の頼みだけが極端に遅い（95 パーセンタイルが跳ねている）",
          "correct": true
        },
        {
          "id": "b",
          "text": "声を出した人の気のせい",
          "correct": false,
          "whyNot": "平均がならしてしまうだけで、遅い頼みは実際にある。遅い方の数値で確かめられる。"
        },
        {
          "id": "c",
          "text": "{{term:server}}の時計がずれている",
          "correct": false,
          "whyNot": "時計のずれは、記録の時刻がおかしくなる問題。頼みが遅くなる理由ではない。"
        }
      ],
      "explanation": "95 パーセンタイルは「遅い方から 5% の境の値」。平均が普段どおりでも、この線が跳ねていれば、20 人に 1 人は待たされている。"
    },
    {
      "id": "q2",
      "kind": "situation",
      "prompt": "「遅い」と言われた。最初にどのグラフを見る？",
      "choices": [
        {
          "id": "a",
          "text": "応答時間とエラーの割合（利用者に近い数値）",
          "correct": true
        },
        {
          "id": "b",
          "text": "{{term:disk}}の使用量",
          "correct": false,
          "whyNot": "原因の候補ではあるが、先に、利用者が困り始めた時刻を利用者に近い数値で決める。"
        },
        {
          "id": "c",
          "text": "サーバ室の温度",
          "correct": false,
          "whyNot": "利用者が困っているか・いつからかは分からない。"
        }
      ],
      "explanation": "利用者に近い数値で「いつから」を決めると、その時刻の前後で変わった資源だけを見ればよくなる。"
    },
    {
      "id": "q3",
      "kind": "cause",
      "prompt": "{{term:app}}のメモリの使用量が、毎日少しずつ増え、再起動すると下がる。原因は？",
      "context": {
        "log": "月 1.2 GB → 火 2.0 GB → 水 2.9 GB → 木 3.7 GB（再起動）→ 金 1.2 GB"
      },
      "choices": [
        {
          "id": "a",
          "text": "アプリが、使い終わったメモリを解放していない（{{term:memory-leak}}）",
          "correct": true
        },
        {
          "id": "b",
          "text": "利用者が毎日増えている",
          "correct": false,
          "whyNot": "利用者が増えたのなら、再起動しても下がらない。再起動で戻るのは、アプリの中に溜まっていた印。"
        },
        {
          "id": "c",
          "text": "ディスクの空きが足りない",
          "correct": false,
          "whyNot": "ディスクは保存の場所。メモリの使用量の増え方とは別の数値。"
        }
      ],
      "explanation": "右肩上がりで、再起動で戻るのはメモリリークの典型。上限に届くと、急に遅くなったり止まったりする。"
    }
  ],
  "practice": {
    "mode": "simulation",
    "purpose": "市の予約サイトが「昼から遅い」と言われた。9:00 から 14:00 までの 4 つのグラフを読み、利用者が遅いと感じ始めた時刻と、遅さの原因の資源を答える。",
    "environment": "sim-read",
    "setup": {
      "questions": [
        {
          "id": "始まり",
          "prompt": "利用者が遅いと感じ始めた時刻は？",
          "options": [
            "10:00",
            "11:30",
            "12:00",
            "13:00"
          ]
        },
        {
          "id": "原因",
          "prompt": "遅さの原因の資源は？",
          "options": [
            "CPU",
            "メモリ",
            "頼みの数"
          ]
        }
      ],
      "panels": [
        {
          "kind": "chart",
          "title": "応答時間（Web サーバ）",
          "unit": "秒",
          "x": [
            "9:00",
            "9:30",
            "10:00",
            "10:30",
            "11:00",
            "11:30",
            "12:00",
            "12:30",
