{
  "id": "git.b.01",
  "domain": "git",
  "level": "beginner",
  "theme": "考え方",
  "title": "バージョン管理とは",
  "goal": "履歴を残す理由と、無いと困る場面を説明できる",
  "minutes": 12,
  "prerequisites": [
    "linux.b.02"
  ],
  "related": [
    "found.b.04",
    "devops.b.01"
  ],
  "next": [
    "git.b.02"
  ],
  "terms": [
    "version-control",
    "file",
    "config-file",
    "server",
    "program",
    "git",
    "repository",
    "commit"
  ],
  "explain": {
    "what": "{{term:version-control}}は、{{term:file}}の変更を版ごとに残し、いつでも前の版に戻れるようにする仕組み。版ごとに、日付・変えた人・何をなぜ変えたかの説明が付く。",
    "why": "上書きで保存すると、前の版は消えて戻れない。「設計図_最新_本当に最新」のように名前を変えて残すと、どれが何の版か分からなくなる。誰が何を変えたかも残らない。",
    "use": "{{term:program}}のコード・{{term:server}}の設定・文書。今の開発では{{term:git}}がよく使われる。履歴を残す場所を{{term:repository}}、記録 1 件を{{term:commit}}と呼ぶ。",
    "when": "「昨日の版に戻して」「この行を変えたのは誰？」と言われた時。変更の後に動かなくなり、前に動いていた版と見比べたい時。",
    "figures": [
      "git-b01-history"
    ]
  },
  "understand": [
    {
      "kind": "situation",
      "prompt": "履歴が無いと、いちばん困るのはどれ？",
      "choices": [
        {
          "id": "a",
          "text": "設定を変えたらサーバが動かなくなった。前の設定が残っていない",
          "correct": true
        },
        {
          "id": "b",
          "text": "新しいファイルを作りたい",
          "correct": false,
          "whyNot": "新しく作るだけなら、履歴が無くても困らない。困るのは、前の状態に戻したい時。"
        },
        {
          "id": "c",
          "text": "ファイルの中身を読みたい",
          "correct": false,
          "whyNot": "今の中身は、履歴が無くても読める。履歴が要るのは、前の版を知りたい時。"
        }
      ],
      "see": "why"
    },
    {
      "kind": "match",
      "prompt": "言葉と説明を結ぶ。",
      "pairs": [
        [
          "リポジトリ",
          "履歴を残している場所"
        ],
        [
          "コミット",
          "説明を付けた、記録 1 件"
        ],
        [
          "バージョン管理",
          "版ごとに残し、戻れるようにする仕組み"
        ]
      ],
      "see": "use"
    }
  ],
  "quiz": [
    {
      "id": "q1",
      "kind": "multi",
      "prompt": "バージョン管理を使う理由を全て選ぶ。",
      "choices": [
        {
          "id": "a",
          "text": "前の版にいつでも戻れる",
          "correct": true
        },
        {
          "id": "b",
          "text": "誰が何をなぜ変えたかが分かる",
          "correct": true
        },
        {
          "id": "c",
          "text": "ファイルの大きさが小さくなる",
          "correct": false,
          "whyNot": "小さくするための仕組みではない。版を残す分、むしろ場所は使う。"
        }
      ],
      "explanation": "戻れることと、変更の経緯が分かることが 2 つの大きな理由。"
    },
    {
      "id": "q2",
      "kind": "situation",
      "prompt": "サーバの{{term:config-file}}は、プログラムではない。履歴を残す必要はある？",
      "choices": [
        {
          "id": "a",
          "text": "ある。設定の変更で止まることも多く、戻せると助かる",
          "correct": true
        },
        {
          "id": "b",
          "text": "ない。履歴を残すのはプログラムのコードだけ",
          "correct": false,
          "whyNot": "設定も変更で壊れる。どの値をいつ変えたかが分かると、原因を早く見つけられる。"
        },
        {
          "id": "c",
          "text": "ない。設定は一度書いたら変えないから",
          "correct": false,
          "whyNot": "設定は運用の中で何度も変わる。変えた時こそ、前の値が要る。"
        }
      ],
      "explanation": "コード・設定・文書など、変わっていく物は何でも履歴を残すとよい。"
    },
    {
      "id": "q3",
      "kind": "term",
      "prompt": "「コミット」とは何？",
      "choices": [
        {
          "id": "a",
          "text": "説明を付けて、その時の状態を履歴に記録した 1 件",
          "correct": true
        },
        {
          "id": "b",
          "text": "ファイルを上書きして保存すること",
          "correct": false,
          "whyNot": "上書きは前の版を消す。コミットは前の版を残したまま、新しい版を足す。"
        },
        {
          "id": "c",
          "text": "履歴を残す場所",
          "correct": false,
          "whyNot": "それはリポジトリ。コミットは、その中に並ぶ記録 1 件。"
        }
      ],
      "explanation": "コミットは履歴の 1 件。いつ・誰が・何を（説明）が付き、いつでもその時点に戻れる。"
    }
  ],
  "practice": {
    "mode": "simulation",
    "purpose": "公園の設計図は、3 回書き直されている。依頼主の電話を読み、履歴の中から、依頼主の言う版に今の設計図を戻す。",
    "environment": "sim-config",
    "setup": {
      "fields": [
        {
          "id": "version",
          "label": "今の設計図にする版",
          "options": [
            "7c2e4a1",
            "4b81d07",
            "e19a5c3",
            "0d3f6b8"
          ],
          "value": "7c2e4a1",
          "note": "選ぶと、その版の設計図が出る"
        }
      ],
      "panels": [
        {
          "kind": "kv",
          "title": "今の設計図（7c2e4a1 の版）",
          "rows": [
            [
              "入口",
              "北側"
            ],
            [
              "駐車場",
              "50 台"
            ],
            [
              "公園",
              "広い"
            ]
          ],
          "when": "field version=7c2e4a1"
        },
        {
          "kind": "kv",
          "title": "今の設計図（4b81d07 の版）",
          "rows": [
            [
              "入口",
              "北側"
            ],
            [
              "駐車場",
              "30 台"
            ],
            [
              "公園",
              "広い"
            ]
          ],
          "when": "field version=4b81d07"
        },
        {
          "kind": "kv",
          "title": "今の設計図（e19a5c3 の版）",
          "rows": [
            [
              "入口",
              "北側"
            ],
            [
              "駐車場",
              "40 台"
            ],
            [
              "公園",
              "小さい"
            ]
          ],
          "when": "field version=e19a5c3"
        },
        {
          "kind": "kv",
          "title": "今の設計図（0d3f6b8 の版）",
          "rows": [
            [
              "入口",
              "南側"
            ],
            [
              "駐車場",
              "40 台"
            ],
            [
              "公園",
              "小さい"
            ]
          ],
          "when": "field version=0d3f6b8"
        },
        {
          "kind": "text",
          "title": "依頼主（市の公園課）からの電話",
          "body": "9 月の終わりに見せてもらった、入口が北側の案がいちばん良かった。公園と駐車場は、その時のままでよい。今の設計図を、その版に戻してほしい。"
        },
        {
          "kind": "table",
          "title": "設計図の履歴（新しい順）",
          "columns": [
            "記録",
            "日付",
            "変えた人",
            "説明"
          ],
          "rows": [
            [
              "7c2e4a1",
              "10/03",
              "佐藤",
              "駐車場を 50 台に増やす"
            ],
            [
              "4b81d07",
              "10/01",
              "佐藤",
              "公園を広げ、駐車場を 30 台に減らす"
            ],
            [
              "e19a5c3",
              "9/29",
              "田中",
              "入口を北側に移す"
            ],
            [
              "0d3f6b8",
              "9/27",
              "田中",
              "最初の案"
            ]
          ]
        }
      ]
    },
    "steps": [
      {
        "id": "restore",
        "purpose": "依頼主の言う版を、履歴の日付と説明から探し、今の設計図をその版に戻す。",
        "check": {
          "kind": "sim",
          "expr": "field version=e19a5c3"
        },
        "afterward": "9/29 の版（入口を北側に移す）に戻した。その後の 2 つの版も履歴に残っているので、気が変わればまた戻れる。",
        "hints": [
          "依頼の手がかりは 2 つ。「9 月の終わり」と「入口が北側」。履歴の日付と説明を、新しい順に読む。",
          "9 月の版は 2 つ。そのうち入口を北側にしたのは、田中さんの 9/29 の版。",
          "`set version e19a5c3` と入れる。"
        ],
        "expectedErrors": [
          "git-wrong-version"
        ],
        "actions": [
          {
            "op": "set",
            "field": "version",
            "value": "e19a5c3"
          }
        ]
      }
    ]
  },
  "result": {
    "success": "日付と説明の付いた履歴から、依頼主の言う版を見つけて戻せた。上書きだけなら、この版はもう無かった。",
    "partial": "ヒントを使って、版を戻せた。次は、履歴が無かったら何が起きたかを説明してみよう。",
    "retry": "まだ依頼主の言う版になっていない。依頼の手がかり（日付と入口の向き）を、履歴の行に 1 つずつ当てよう。"
  },
  "summary": {
    "points": [
      "履歴を残す",
      "いつでも戻れる",
      "誰が何を変えたか分かる"
    ],
    "next": [
      "git.b.02"
    ],
    "terms": [
      "version-control",
      "repository",
      "commit"
    ]
  }
}
