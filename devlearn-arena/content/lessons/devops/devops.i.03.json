{
  "id": "devops.i.03",
  "domain": "devops",
  "level": "intermediate",
  "theme": "振り返り",
  "title": "ポストモーテム",
  "goal": "責めない振り返りと再発防止を書ける",
  "minutes": 20,
  "prerequisites": [
    "trouble.i.01"
  ],
  "related": [
    "sec.a.03",
    "mon.a.01"
  ],
  "next": [
    "devops.a.02",
    "trouble.a.03"
  ],
  "terms": [
    "postmortem",
    "terminal"
  ],
  "explain": {
    "what": "{{term:postmortem}}は、障害の後に、責めずに事実と原因と対策をまとめる振り返り。時系列・影響・原因・うまくいった事・対策を、担当と期限つきで書く。",
    "why": "人を責めると事実が隠れ、同じ事故が起きる。誤りが起きる仕組みの方を直せば、次の人も助かる。",
    "use": "再発防止と知識の共有に使う。誰でも読める場所に置き、対策が実行されたかを後で確かめる。",
    "when": "誤った操作で本番が 40 分止まった。操作した人は落ち込んでいる。同じ事を二度と起こしたくない。",
    "figures": [
      "devops-i03-postmortem"
    ]
  },
  "understand": [
    {
      "kind": "order",
      "prompt": "書く順に並べる。",
      "items": [
        "時系列と影響",
        "原因（仕組み）",
        "うまくいった事",
        "対策と担当と期限"
      ],
      "see": "what"
    },
    {
      "kind": "yesno",
      "prompt": "誰の誤りかを書いて、責任を問う。",
      "answer": false,
      "why": "責めると事実が隠れる。誤りが起きた仕組みを書く。",
      "see": "why"
    }
  ],
  "quiz": [
    {
      "id": "q1",
      "kind": "situation",
      "prompt": "原因が人の操作の誤りだった。何を直す？",
      "choices": [
        {
          "id": "a",
          "text": "誤りが起きた仕組み",
          "correct": true
        },
        {
          "id": "b",
          "text": "その人の配置",
          "correct": false,
          "whyNot": "別の人でも同じ誤りが起きる。"
        },
        {
          "id": "c",
          "text": "何も直さない",
          "correct": false,
          "whyNot": "同じ事故が起きる。"
        }
      ],
      "explanation": "本番の操作に確認を入れるなど、仕組みで防ぐ。"
    },
    {
      "id": "q2",
      "kind": "choice",
      "prompt": "対策に要る物は？",
      "choices": [
        {
          "id": "a",
          "text": "担当と期限",
          "correct": true
        },
        {
          "id": "b",
          "text": "反省の言葉",
          "correct": false,
          "whyNot": "反省では、仕組みが変わらない。"
        },
        {
          "id": "c",
          "text": "長い説明",
          "correct": false,
          "whyNot": "長さより、誰がいつまでにするか。"
        }
      ],
      "explanation": "担当と期限が無いと、実行されない。"
    },
    {
      "id": "q3",
      "kind": "cause",
      "prompt": "同じ事故が再発した。原因は？",
      "choices": [
        {
          "id": "a",
          "text": "対策を実行していない",
          "correct": true
        },
        {
          "id": "b",
          "text": "文書が短い",
          "correct": false,
          "whyNot": "短くても、実行していれば防げた。"
        },
        {
          "id": "c",
          "text": "運が悪い",
          "correct": false,
          "whyNot": "同じ事故なら、仕組みが変わっていない。"
        }
      ],
      "explanation": "対策が終わったかを追いかける。"
    }
  ],
  "practice": {
    "mode": "simulation",
    "purpose": "障害の記録から振り返りを書く。文の札を「時系列と影響」「原因（仕組み）」「対策（担当と期限）」に入れ、責める文と担当の無い文は「書かない」へ入れる。",
    "environment": "sim-assign",
    "setup": {
      "slots": [
        {
          "id": "facts",
          "label": "時系列と影響"
        },
        {
          "id": "cause",
          "label": "原因（仕組み）"
        },
        {
          "id": "action",
          "label": "対策（担当と期限）"
        },
        {
          "id": "drop",
          "label": "書かない"
        }
      ],
      "items": [
        {
          "id": "t1",
          "label": "14:02 本番の DB の表を消した。予約が 40 分止まった"
        },
        {
          "id": "c1",
          "label": "本番と検証の端末が同じ見た目で、確認なしで消せた"
        },
        {
          "id": "a1",
          "label": "本番の端末の色を変える（佐藤・10/20 まで）"
        },
        {
          "id": "a2",
          "label": "消す操作に確認を入れる（高橋・10/31 まで）"
        },
        {
          "id": "b1",
          "label": "田中さんの不注意が悪い"
        },
        {
          "id": "b2",
          "label": "もっと気を付ける"
        }
      ]
    },
    "steps": [
      {
        "id": "write",
        "purpose": "4 つの札を正しい枠に入れる。事実は「時系列と影響」、起きた仕組みは「原因（仕組み）」、担当と期限のある文は「対策（担当と期限）」へ。",
        "check": {
          "kind": "sim",
          "expr": "in t1=facts c1=cause a1=action a2=action"
        },
        "afterward": "事実・仕組み・対策が揃った。{{term:terminal}}の見た目が同じなら、誰でも間違える。",
        "hints": [
          "時刻のある文が事実。",
          "「なぜ起きる仕組みだったか」が原因。担当と期限のある文が対策。",
          "「14:02 本番の DB の表を消した。予約が 40 分止まった」を「時系列と影響」へ、「本番と検証の端末が同じ見た目で、確認なしで消せた」を「原因（仕組み）」へ、「本番の端末の色を変える（佐藤・10/20 まで）」と「消す操作に確認を入れる（高橋・10/31 まで）」を「対策（担当と期限）」へドラッグして入れる。"
        ],
        "actions": [
          {
            "op": "put",
            "item": "t1",
            "slot": "facts"
          },
          {
            "op": "put",
            "item": "c1",
            "slot": "cause"
          },
          {
            "op": "put",
            "item": "a1",
            "slot": "action"
          },
          {
            "op": "put",
            "item": "a2",
            "slot": "action"
          }
        ],
        "expectedErrors": [
          "devops-blame"
        ]
      },
      {
        "id": "no-blame",
        "purpose": "責める文と、担当の無い文を「書かない」へ入れる。",
        "check": {
          "kind": "sim",
          "expr": "in b1=drop b2=drop"
        },
        "afterward": "個人を責める文と、実行できない文を外した。これで、書いた人も操作した人も、事実を隠さずに済む。",
        "hints": [
          "個人を責める文は書かない。",
          "「もっと気を付ける」は、誰がいつ何をするか分からない。",
          "「田中さんの不注意が悪い」と「もっと気を付ける」を「書かない」へドラッグして入れる。"
        ],
        "actions": [
          {
            "op": "put",
            "item": "b1",
            "slot": "drop"
          },
          {
            "op": "put",
            "item": "b2",
            "slot": "drop"
          }
        ],
        "expectedErrors": [
          "devops-blame"
        ]
      }
    ]
  },
  "result": {
    "success": "責めずに、事実と仕組みと対策をまとめられた。",
    "partial": "ヒントを使って書けた。次は、対策が実行されたかを追う方法も考えてみよう。",
    "retry": "個人を責める文か、担当の無い対策が残っている。札を見直そう。"
  },
  "summary": {
    "points": [
      "責めない",
      "仕組みを直す",
      "担当と期限を決める"
    ],
    "next": [
      "devops.a.02",
      "trouble.a.03"
    ],
    "terms": [
      "postmortem",
      "runbook"
    ]
  }
}
